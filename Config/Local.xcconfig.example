// Copy to Config/Local.xcconfig (git-ignored). Find your values with:
//   security find-identity -v -p codesigning
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = YOURTEAMID

// iCloud sync only works for the team that owns iCloud.sh.saeed.kudzu, and the
// entitlement requires a provisioning profile. Automatic signing creates one
// after the App ID has the iCloud capability and that container. Other teams
// should leave these lines commented out; the app then stays local-only.
// The icloud entitlements files use the Development container. A release
// build that ships to other people has to use Production instead.
// CODE_SIGN_STYLE = Automatic
// KUDZU_DIRECT_ENTITLEMENTS = Kudzu/Resources/Kudzu.icloud.entitlements
// KUDZU_APPSTORE_ENTITLEMENTS = Kudzu/Resources/KudzuAppStore.icloud.entitlements
