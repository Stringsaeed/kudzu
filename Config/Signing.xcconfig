// Code signing defaults. Ad-hoc so anyone can build from source.
//
// Ad-hoc signatures change on every build, and macOS ties privacy grants
// (Accessibility, Input Monitoring) to the signature, so grants get lost.
// To keep them across rebuilds, copy Local.xcconfig.example to Local.xcconfig
// (git-ignored) and fill in your own team and identity.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
