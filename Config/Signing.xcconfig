// Code signing defaults. Ad-hoc so anyone can build from source.
//
// Ad-hoc signatures change on every build, and macOS ties privacy grants
// (Accessibility, Input Monitoring) to the signature, so grants get lost.
// To keep them across rebuilds, copy Local.xcconfig.example to Local.xcconfig
// (git-ignored) and fill in your own team and identity.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// Default builds stay ad-hoc and local-only. A signed build opts into CloudKit by
// overriding these with the *.icloud.entitlements files (see Local.xcconfig.example).
KUDZU_DIRECT_ENTITLEMENTS = Kudzu/Resources/Kudzu.entitlements
KUDZU_APPSTORE_ENTITLEMENTS = Kudzu/Resources/KudzuAppStore.entitlements

#include? "Local.xcconfig"
