      "match/base.yml": "# Realistic Espanso base match file\nimports:\n  - \"./_private.yml\"\n\nglobal_vars:\n  - name: company_date\n    type: date\n    params:\n      format: \"%Y-%m-%d\"\n\nmatches:\n  - trigger: \":sig\"\n    label: \"Email Signature\"\n    replace: |\n      Best regards,\n      Jane Doe\n\n  - triggers: [\":hello\", \":hi\"]\n    replace: \"Hello there!\"\n    word: true\n    propagate_case: true\n\n  - trigger: \"ther\"\n    replace: \"there\"\n    word: true\n    propagate_case: true\n\n  - trigger: \":div\"\n    label: \"HTML Div\"\n    replace: \"<div>$|$</div>\"\n    force_mode: keys\n\n  - trigger: \":escaped\"\n    replace: \"Literal braces \\\\{\\\\{not_a_var}} here\"\n",
      "match/dynamic.yml": "# Dates, clipboard, nested matches, and global_vars\nmatches:\n  - trigger: \":now\"\n    label: \"Current Time\"\n    replace: \"It's {{mytime}}\"\n    vars:\n      - name: mytime\n        type: date\n        params:\n          format: \"%H:%M\"\n\n  - trigger: \":tomorrow\"\n    label: \"Tomorrow Date\"\n    replace: \"Tomorrow is {{tom}}\"\n    vars:\n      - name: tom\n        type: date\n        params:\n          format: \"%Y-%m-%d\"\n          offset: 86400\n          locale: \"en_US\"\n\n  - trigger: \":full_date\"\n    replace: \"{{dt}}\"\n    vars:\n      - name: dt\n        type: date\n        params:\n          format: \"%A, %B %e, %Y %I:%M:%S %p (%a %b %d '%y day %j %Z %z) 100%%\"\n\n  - trigger: \":paste_link\"\n    label: \"HTML Link from Clipboard\"\n    replace: \"<a href=\\\"{{clip}}\\\">$|$</a>\"\n    vars:\n      - name: clip\n        type: clipboard\n\n  - trigger: \":nested_sig\"\n    label: \"Nested Signature\"\n    replace: \"Thanks!\\n{{sig_var}}\"\n    vars:\n      - name: sig_var\n        type: match\n        params:\n          trigger: \":sig\"\n",
      "match/forms.yml": "# Espanso forms fixture (both shorthand form: and verbose type: form)\nmatches:\n  - trigger: \":greet\"\n    label: \"Birthday Greeting\"\n    form: \"Hey [[name]], [[note]]!\"\n    form_fields:\n      name:\n        default: \"Friend\"\n      note:\n        multiline: true\n        default: \"Happy Birthday\"\n\n  - trigger: \":order\"\n    label: \"Order Drink\"\n    form: \"Order: [[drink]] ([[size]])\"\n    form_fields:\n      drink:\n        type: choice\n        values:\n          - \"Coffee\"\n          - \"Tea|Green\"\n          - \"Juice\"\n        default: \"Coffee\"\n      size:\n        type: list\n        values: |\n          Small\n          Medium\n          Large\n\n  - trigger: \":verbose_form\"\n    label: \"Verbose Form\"\n    replace: \"Hi {{form1.user}}, role: {{form1.role}}\"\n    vars:\n      - name: form1\n        type: form\n        params:\n          layout: \"User: [[user]]\\nRole: [[role]]\"\n          fields:\n            user:\n              default: \"Admin\"\n            role:\n              type: choice\n              values:\n                - \"Developer\"\n                - \"Designer\"\n              default: \"Developer\"\n",
      "match/unsupported.yml": "# Unsupported or partially degraded Espanso features\nmatches:\n  - regex: \":greet\\\\((?P<person>.*)\\\\)\"\n    replace: \"Hi {{person}}!\"\n\n  - trigger: \":cat\"\n    image_path: \"$CONFIG/images/cat.png\"\n\n  - trigger: \":rich_md\"\n    markdown: \"This *text* is **bold**\"\n\n  - trigger: \":rich_html\"\n    html: \"<p>Hello <b>world</b></p>\"\n\n  - trigger: \":ip\"\n    replace: \"IP: {{output}}\"\n    vars:\n      - name: output\n        type: shell\n        params:\n          cmd: \"curl https://api.ipify.org\"\n\n  - trigger: \":py\"\n    replace: \"Out: {{script_out}}\"\n    vars:\n      - name: script_out\n        type: script\n        params:\n          args: [\"python\", \"script.py\"]\n\n  - trigger: \":rand\"\n    replace: \"Quote: {{r}}\"\n    vars:\n      - name: r\n        type: random\n        params:\n          choices: [\"One\", \"Two\"]\n\n  - trigger: \":echo_test\"\n    replace: \"Echo: {{e}}\"\n    vars:\n      - name: e\n        type: echo\n        params:\n          echo: \"Fixed\"\n\n  - trigger: \":broken_nest\"\n    replace: \"Missing: {{missing_match}}\"\n    vars:\n      - name: missing_match\n        type: match\n        params:\n          trigger: \":nonexistent_trigger\"\n\n  - trigger: \":weird_date\"\n    replace: \"{{wd}}\"\n    vars:\n      - name: wd\n        type: date\n        params:\n          format: \"%Y-%V-%u\"\n",
