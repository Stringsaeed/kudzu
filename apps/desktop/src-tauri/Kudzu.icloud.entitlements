<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iCloud entitlements for release builds (Developer ID + notarized DMG). These are restricted:
  macOS kills a signed app that claims them without the matching embedded provisioning profile,
  so they're only applied through tauri.icloud.conf.json when Kudzu.provisionprofile exists
  (see scripts/release/build.sh). Production environment: every distributed build must use it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>V3HN8HXZYK.sh.saeed.kudzu</string>
	<key>com.apple.developer.team-identifier</key>
	<string>V3HN8HXZYK</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.sh.saeed.kudzu</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
