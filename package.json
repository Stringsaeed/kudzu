{
  "name": "kudzu",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:website": "turbo run dev --filter=kudzu-website",
    "dev:app": "bash apps/macos/scripts/dev.sh",
    "build": "turbo run build",
    "build:website": "turbo run build --filter=kudzu-website",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck",
    "test:macos": "cd apps/macos/Packages/KudzuKit && swift test"
  },
  "devDependencies": {
    "oxlint": "1.91.0",
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1"
}
